# KAGURA DB 環境設定ファイル (Windows版)
#
# インストール時に C:\ProgramData\KaguraDB\config\kagura.env として配置され、
# タスクスケジューラから起動される run-kagura.ps1 が読み込みます。
# KAGURA_MASTER_KEY はインストール時にランダム生成され、この雛形とは別に書き込まれます。
# 値を変更した場合は下記コマンドでタスクを再起動してください:
#   Stop-ScheduledTask -TaskName KaguraDB; Start-ScheduledTask -TaskName KaguraDB

# 保存先ファイルパス（拡張子 .kdb = 暗号化KDBモード）
DB_FILE=C:\ProgramData\KaguraDB\data\db_data.kdb

# バインドアドレス
DB_ADDR=0.0.0.0:3000

# KDB暗号化マスターキー (hex64・64桁の16進数文字列)
KAGURA_MASTER_KEY=

# ログ保存先ファイルパス
KAGURA_LOG_FILE=C:\ProgramData\KaguraDB\logs\kagura.log

# 認証情報（管理者ユーザー名・パスワードハッシュ）保存先ファイルパス
# 初回起動時にファイルが無ければ username=kagura, password=root で自動作成される
KAGURA_AUTH_FILE=C:\ProgramData\KaguraDB\data\auth.json
