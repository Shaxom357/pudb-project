# KAGURA DB 環境設定ファイル
#
# インストール時に /etc/kagura-db/kagura.env として配置され、
# systemd の EnvironmentFile として読み込まれます（root:kagura, 640）。
# KAGURA_MASTER_KEY はインストール時にランダム生成され、この雛形とは別に書き込まれます。
# 値を変更した場合は `systemctl restart kagura-db` で反映してください。

# 保存先ファイルパス（拡張子 .kdb = 暗号化KDBモード）
DB_FILE=/var/lib/kagura-db/db_data.kdb

# バインドアドレス
DB_ADDR=0.0.0.0:3000

# KDB暗号化マスターキー (hex64・64桁の16進数文字列)
# 例: openssl rand -hex 32
KAGURA_MASTER_KEY=

# ログ保存先ファイルパス
KAGURA_LOG_FILE=/var/log/kagura-db/kagura.log

# 認証情報（管理者ユーザー名・パスワードハッシュ）保存先ファイルパス
# 初回起動時にファイルが無ければ username=kagura, password=root で自動作成される
KAGURA_AUTH_FILE=/var/lib/kagura-db/auth.json
