# Rust ビルド成果物（全クレートの target/ を除外）
target/

# Cargo.lock はアプリケーションはコミットするが、ライブラリはしない
# ワークスペースのルート Cargo.lock のみ管理する
db_engine/Cargo.lock
db_ffi/Cargo.lock
dynamic_label_management/Cargo.lock

# IDE / エディタ設定
.vscode/
.idea/
*.swp
*.swo

# OS 一時ファイル
.DS_Store
Thumbs.db

# 環境変数・機密情報
.env
*.pem
credentials

# データファイル（サーバー起動時に生成されるDBファイル）
*.json.tmp
db_data.json

# ログファイル（サーバー起動時に生成されるログ保管先）
logs/
*.log

# Python キャッシュ
__pycache__/
*.pyc
*.pyo

